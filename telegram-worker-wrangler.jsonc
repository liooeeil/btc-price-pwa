{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tide-btc-alerts",
  "main": "telegram-worker.js",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "ALERT_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
